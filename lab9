#include <stdio.h>
#include <math.h>


void p_ab(int a[], int n){
    for (int i =0; i < n; i+=1){
        printf("a[%d] = %d \n", i, a[i]);
    }
}
void p3(int a[], int n, int b[]){
    
    double sum;
    for (int i =0; i < n; i+=1){
        printf("a[%d] = %d \n", i, a[i]);
        printf("b[%d] = %d \n", i, b[i]);
    }
    return sum = sum + a[i] * b[i];
}



int main(){

    int n = 5;
    int a[n];
    for (int i = 0; i < n; i+=1){
        printf("a[%d] = ", i); scanf("%d", &a[i]);
    }
    
    p_ab(a,n);
    printf("\n");

    int b[n];
    p3(a,n,b);




}
